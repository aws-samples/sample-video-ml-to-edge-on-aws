{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SampleBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:DeleteObject",
        "s3:DeleteObjectTagging",
        "s3:DeleteObjectVersion",
        "s3:DeleteObjectVersionTagging",
        "s3:GetBucketLocation",
        "s3:GetBucketNotification",
        "s3:GetBucketPolicy",
        "s3:GetBucketTagging",
        "s3:GetObject",
        "s3:GetObjectTagging",
        "s3:GetObjectVersion",
        "s3:GetObjectVersionTagging",
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:PutBucketNotification",
        "s3:PutBucketPolicy",
        "s3:PutObject",
        "s3:PutObjectLegalHold",
        "s3:PutObjectRetention",
        "s3:PutObjectTagging",
        "s3:PutObjectVersionTagging"
      ],
      "Resource": [
        "arn:aws:s3:::conveyor*"
      ],
      "Condition": {
        "StringEquals": {
          "s3:ResourceAccount": "${aws:PrincipalAccount}"
        }
      }
    },
    {
      "Sid": "ReadCdkAssets",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::cdk-hnb659fds-assets-${aws:PrincipalAccount}-*"
      ]
    },
    {
      "Sid": "SampleKeys",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:GetPublicKey",
        "kms:ReEncryptFrom",
        "kms:ReEncryptTo"
      ],
      "Resource": [
        "arn:aws:kms:*:${aws:PrincipalAccount}:key/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/project": "sample-video-ml-to-edge"
        }
      }
    },
    {
      "Sid": "SignOnlyAsTheReleaseFunction",
      "Effect": "Allow",
      "Action": [
        "kms:Sign"
      ],
      "Resource": [
        "arn:aws:kms:*:${aws:PrincipalAccount}:key/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/project": "sample-video-ml-to-edge"
        },
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::${aws:PrincipalAccount}:role/ConveyorMl-PublishFnServiceRole*"
        }
      }
    },
    {
      "Sid": "CdkAssetBucketKey",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": [
        "arn:aws:kms:*:${aws:PrincipalAccount}:key/*"
      ],
      "Condition": {
        "StringLike": {
          "kms:ViaService": "s3.*.amazonaws.com"
        }
      }
    },
    {
      "Sid": "SampleLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:DescribeLogStreams",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:*:${aws:PrincipalAccount}:log-group:Conveyor*",
        "arn:aws:logs:*:${aws:PrincipalAccount}:log-group:/aws/lambda/Conveyor*",
        "arn:aws:logs:*:${aws:PrincipalAccount}:log-group:/aws/sagemaker/TrainingJobs*"
      ]
    },
    {
      "Sid": "CreateRunTimeLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup"
      ],
      "Resource": [
        "arn:aws:logs:*:${aws:PrincipalAccount}:log-group:/aws/lambda/Conveyor*",
        "arn:aws:logs:*:${aws:PrincipalAccount}:log-group:/aws/sagemaker/TrainingJobs*"
      ]
    },
    {
      "Sid": "GuardDutyScanRules",
      "Effect": "Allow",
      "Action": [
        "events:DeleteRule",
        "events:DescribeRule",
        "events:ListTargetsByRule",
        "events:PutRule",
        "events:PutTargets",
        "events:RemoveTargets"
      ],
      "Resource": [
        "arn:aws:events:*:${aws:PrincipalAccount}:rule/DO-NOT-DELETE-AmazonGuardDutyMalwareProtectionS3*"
      ]
    },
    {
      "Sid": "ReleaseModelPackages",
      "Effect": "Allow",
      "Action": [
        "sagemaker:DescribeModelPackage"
      ],
      "Resource": [
        "arn:aws:sagemaker:*:${aws:PrincipalAccount}:model-package/conveyor-events/*"
      ]
    },
    {
      "Sid": "RegisterTrainedModels",
      "Effect": "Allow",
      "Action": [
        "sagemaker:CreateModelPackage",
        "sagemaker:DescribeTrainingJob"
      ],
      "Resource": [
        "arn:aws:sagemaker:*:${aws:PrincipalAccount}:model-package-group/conveyor-events",
        "arn:aws:sagemaker:*:${aws:PrincipalAccount}:model-package/conveyor-events/*",
        "arn:aws:sagemaker:*:${aws:PrincipalAccount}:training-job/tiny3d-*"
      ]
    },
    {
      "Sid": "PortalInvalidation",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation"
      ],
      "Resource": [
        "arn:aws:cloudfront::${aws:PrincipalAccount}:distribution/*"
      ]
    },
    {
      "Sid": "RestrictDefaultSecurityGroups",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress"
      ],
      "Resource": [
        "arn:aws:ec2:*:${aws:PrincipalAccount}:security-group/*"
      ]
    },
    {
      "Sid": "TrainingImages",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": [
        "arn:aws:ecr:*:763104351884:repository/pytorch-*"
      ]
    },
    {
      "Sid": "TrainingMetrics",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "/aws/sagemaker/TrainingJobs"
        }
      }
    },
    {
      "Sid": "SessionManagerAgent",
      "Effect": "Allow",
      "Action": [
        "ssm:UpdateInstanceInformation"
      ],
      "Resource": [
        "arn:aws:ec2:*:${aws:PrincipalAccount}:instance/*"
      ]
    },
    {
      "Sid": "NoResourceLevelS3PrefixListLookup",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeManagedPrefixLists"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NoResourceLevelTrainingImageRegistryLogin",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NoResourceLevelSessionManagerAgent",
      "Effect": "Allow",
      "Action": [
        "ssmmessages:CreateControlChannel",
        "ssmmessages:CreateDataChannel",
        "ssmmessages:OpenControlChannel",
        "ssmmessages:OpenDataChannel"
      ],
      "Resource": "*"
    }
  ]
}
